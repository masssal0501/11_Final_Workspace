# 로컬 개발용 환경변수 예시 파일.
# 실제로 사용하려면 이 파일을 .env.local로 복사한 뒤 값을 채워 넣는다.
# (.env.local은 .gitignore에 의해 커밋되지 않음)
#
# 아무 것도 설정하지 않아도 아래 기본값(localhost:8006)으로 동작하도록
# 코드에 fallback이 들어가 있어 로컬 개발은 이 파일 없이도 가능하다.
# 다만 Kakao 지도 기능을 쓰려면 VITE_KAKAO_APP_KEY는 반드시 필요하다.

# 백엔드 API 기본 URL
# - 로컬 개발: http://localhost:8006/workflow (기본값, 생략 가능)
# - Production 빌드: GitHub Actions가 빌드 시점에 "/workflow"(상대경로)로 주입한다
#   (Nginx가 같은 origin에서 프록시하므로 CORS 자체가 필요 없어짐)
VITE_API_BASE_URL=http://localhost:8006/workflow

# Kakao Maps JavaScript SDK 앱 키 (Kakao Developers 콘솔에서 발급)
VITE_KAKAO_APP_KEY=
