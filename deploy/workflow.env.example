# WorkFlow ERP - Production 환경변수 템플릿
#
# 실제 값을 채운 뒤 EC2에 다음 경로로 올린다 (Git에는 절대 실제 값을 커밋하지 않는다):
#   /etc/workflow/workflow.env
#
# 권장 권한: root 또는 workflow 사용자만 읽을 수 있도록 제한
#   sudo mkdir -p /etc/workflow
#   sudo nano /etc/workflow/workflow.env   # 아래 항목을 채워서 저장
#   sudo chown root:workflow /etc/workflow/workflow.env
#   sudo chmod 640 /etc/workflow/workflow.env
#
# workflow.service가 EnvironmentFile로 이 파일을 읽는다.

# --- RDS MySQL 연결 정보 ---
DB_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/workflow?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USERNAME=<RDS_USERNAME>
DB_PASSWORD=<RDS_PASSWORD>

# --- JWT ---
# openssl rand -base64 48  등으로 충분히 긴 랜덤 값 생성해서 사용할 것
# (application.properties의 로컬 개발용 기본값을 절대 재사용하지 말 것)
JWT_SECRET=<STRONG_RANDOM_SECRET>
JWT_EXPIRATION=3600000

# --- Google Gemini API (AI 여행지 추천) ---
GEMINI_API_KEY=<GEMINI_API_KEY>

# --- Gmail (임시비밀번호/인증번호 발송) ---
MAIL_USERNAME=<GMAIL_ADDRESS>
MAIL_PASSWORD=<GMAIL_APP_PASSWORD>

# --- CORS ---
# Nginx가 프론트/백엔드를 같은 origin으로 서빙하므로 same-origin 요청에는
# CORS가 필요 없지만, 다른 origin에서의 접근(별도 도메인/HTTPS 전환 등)을
# 대비해 실제 서비스 도메인 또는 EC2 공인 IP를 명시한다. 콤마로 복수 지정 가능.
CORS_ALLOWED_ORIGINS=http://<EC2_PUBLIC_IP_OR_DOMAIN>

# --- 파일 업로드 경로 (systemd의 workflow 사용자가 쓰기 권한을 가져야 함) ---
APP_UPLOAD_RECEIPTS_DIR=/opt/workflow/uploads/receipts/
