# WorkFlow ERP Backend - systemd service
#
# 배포 위치: /etc/systemd/system/workflow.service
#
# 최초 설치:
#   sudo cp deploy/systemd/workflow.service /etc/systemd/system/workflow.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable workflow
#   sudo systemctl start workflow
#
# 재시작(재배포 시 GitHub Actions가 SSM으로 실행하는 것과 동일한 명령):
#   sudo systemctl restart workflow
#
# 상태/로그 확인:
#   sudo systemctl status workflow
#   sudo journalctl -u workflow -f

[Unit]
Description=WorkFlow ERP Spring Boot Backend
After=network.target

[Service]
Type=simple
User=workflow
Group=workflow
WorkingDirectory=/opt/workflow/backend

# DB_URL, DB_USERNAME, DB_PASSWORD, JWT_SECRET, GEMINI_API_KEY,
# MAIL_USERNAME, MAIL_PASSWORD, CORS_ALLOWED_ORIGINS, APP_UPLOAD_RECEIPTS_DIR
# 는 전부 이 파일(EC2에만 존재, Git에는 올라가지 않음)로 주입한다.
EnvironmentFile=/etc/workflow/workflow.env
Environment=SPRING_PROFILES_ACTIVE=prod

ExecStart=/usr/bin/java -jar /opt/workflow/backend/workflow-backend.jar

# 배포 시 GitHub Actions가 JAR을 새로 내려받은 뒤 이 서비스를 재시작한다
Restart=on-failure
RestartSec=5

# 표준 출력/에러를 journal로 (journalctl -u workflow 로 확인)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=workflow

# 파일 업로드 디렉터리 등에 쓰기 위한 최소 권한 설정
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
