<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.workflow.amount.dao.AmountDao">


    <!-- =========================================================
         1. Amount ResultMap
         ========================================================= -->

  
<resultMap id="amountResultMap"
           type="com.kh.workflow.amount.vo.Amount">

    <!-- 1. PK -->
    <id property="amountNo"
        column="amount_no"/>

    <!-- 2. 일반 컬럼 -->
    <result property="requestedAmount"
            column="requested_amount"/>

    <result property="approvedAmount"
            column="approved_amount"/>

    <result property="requestedAt"
            column="requested_at"/>

    <result property="approvedAt"
            column="approved_at"/>

    <result property="createdAt"
            column="created_at"/>

    <result property="updatedAt"
            column="updated_at"/>

    <result property="status"
            column="status"/>

    <result property="amountComment"
            column="amount_comment"/>

    <result property="workcationNo"
            column="workcation_no"/>

    <result property="empName"
            column="emp_name"/>


    <!-- 3. association은 collection보다 먼저 -->
    <association property="sponsor"
                 javaType="com.kh.workflow.amount.vo.Amount$Sponsor"
                 select="selectSponsorByAmountNo"
                 column="amount_no"/>


    <!-- 4. collection -->
    <collection property="itemList"
                ofType="com.kh.workflow.amount.vo.Amount$Item"
                select="selectAmountItemsByAmountNo"
                column="amount_no"/>

    <collection property="fileList"
                ofType="com.kh.workflow.amount.vo.Amount$File"
                select="selectAmountFilesByAmountNo"
                column="amount_no"/>

</resultMap>




    <!-- =========================================================
         2. Item ResultMap
         ========================================================= -->

   <resultMap id="itemResultMap"
           type="com.kh.workflow.amount.vo.Amount$Item">

    <id property="itemNo" column="item_no"/>

    <result property="amount" column="amount"/>

    <result property="itemApprovedAmount"
            column="item_approved_amount"/>

    <result property="amountamountitemType"
            column="amountamountitem_type"/>

    <result property="itemDate" column="item_date"/>
    <result property="itemApproved" column="item_approved"/>
    <result property="itemDescription" column="item_description"/>
    <result property="amountNo" column="amount_no"/>

</resultMap>



    <!-- =========================================================
         3. Sponsor ResultMap
         ========================================================= -->

   <resultMap id="sponsorResultMap"
           type="com.kh.workflow.amount.vo.Amount$Sponsor">

    <id property="amountNo" column="amount_no"/>

    <result property="sponsorName"
            column="sponsor_name"/>

    <result property="amount"
            column="amount"/>

    <result property="paymentDate"
            column="payment_date"/>

    <result property="status"
            column="status"/>

    <result property="remark"
            column="remark"/>

    <result property="itemNo"
            column="item_no"/>

</resultMap>



    <!-- =========================================================
         4. File ResultMap
         ========================================================= -->

    <resultMap id="fileResultMap"
               type="com.kh.workflow.amount.vo.Amount$File">

        <id property="amountattachmentNo"
            column="amountattachment_no"/>

        <result property="amountNo"
                column="amount_no"/>

        <result property="originName"
                column="origin_name"/>

        <result property="changeName"
                column="change_name"/>

        <result property="filePath"
                column="file_path"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

    </resultMap>



    <!-- =========================================================
         5. 관리자 비용 목록 COUNT
         ========================================================= -->

    <select id="getAmountListCount"
            resultType="int">

        SELECT COUNT(*)

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

    </select>



    <!-- =========================================================
         6. 관리자 비용 목록
         ========================================================= -->

    <select id="selectAmountList"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name AS emp_name

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        ORDER BY a.amount_no DESC

    </select>



    <!-- =========================================================
         7. 비용 상세 조회
         ========================================================= -->

    <select id="selectAmountById"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name AS emp_name

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        WHERE a.amount_no = #{amountNo}

    </select>



    <!-- =========================================================
         8. 비용 항목 목록 조회
         ========================================================= -->

   <select id="selectAmountItemsByAmountNo"
        resultMap="itemResultMap">

    SELECT
        item_no,
        amount,
        amountamountitem_type,
        item_date,
        item_approved,
        item_description,
        amount_no,
        item_approved_amount
    FROM amount_item
    WHERE amount_no = #{amountNo}
    ORDER BY item_no

</select>



    <!-- =========================================================
         9. 지자체 지원금 조회
         
         기존 select ID 유지
         ========================================================= -->

    <select id="selectSponsorByAmountNo"
        parameterType="int"
        resultMap="sponsorResultMap">

    SELECT
        amount_no,
        sponsor_name,
        amount,
        payment_date,
        status,
        remark,
        item_no
    FROM amount_list
    WHERE amount_no = #{amountNo}

</select>



    <!-- =========================================================
         10. 첨부파일 목록 조회
         ========================================================= -->

    <select id="selectAmountFilesByAmountNo"
            parameterType="int"
            resultMap="fileResultMap">

        SELECT
            amountattachment_no,
            amount_no,
            origin_name,
            change_name,
            file_path,
            updated_at,
            status

        FROM amount_file

        WHERE amount_no = #{amountNo}

        ORDER BY amountattachment_no ASC

    </select>



    <!-- =========================================================
         11. 워케이션별 비용 COUNT
         ========================================================= -->

    <select id="selectAmountCountByWorkcationNo"
            parameterType="int"
            resultType="int">

        SELECT COUNT(*)

        FROM amount

        WHERE workcation_no = #{workcationNo}

    </select>



    <!-- =========================================================
         12. 워케이션별 비용 목록
         ========================================================= -->

    <select id="selectAmountListByWorkcationNo"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name AS emp_name

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        WHERE a.workcation_no = #{workcationNo}

        ORDER BY a.amount_no DESC

    </select>



    <!-- =========================================================
         13. 비용 등록
         ========================================================= -->

    <insert id="insertAmount"
            parameterType="com.kh.workflow.amount.vo.Amount"
            useGeneratedKeys="true"
            keyProperty="amountNo">

        INSERT INTO amount (
            requested_amount,
            approved_amount,
            requested_at,
            approved_at,
            status,
            amount_comment,
            workcation_no
        )

        VALUES (
            #{requestedAmount},
            #{approvedAmount},
            #{requestedAt},
            #{approvedAt},
            #{status},
            #{amountComment},
            #{workcationNo}
        )

    </insert>



    <!-- =========================================================
         14. 비용 항목 등록
         ========================================================= -->

   <insert id="insertAmountItem"
        parameterType="com.kh.workflow.amount.vo.Amount$Item"
        useGeneratedKeys="true"
        keyProperty="itemNo">

    INSERT INTO amount_item (
        amount,
        item_approved_amount,
        amountamountitem_type,
        item_date,
        item_approved,
        item_description,
        amount_no
    )

    VALUES (
        #{amount},
        #{itemApprovedAmount},
        #{amountamountitemType},
        #{itemDate},
        #{itemApproved},
        #{itemDescription},
        #{amountNo}
    )

</insert>


    <!-- =========================================================
         15. 지자체 지원금 등록
         ========================================================= -->

    <insert id="insertAmountSponsor"
            parameterType="com.kh.workflow.amount.vo.Amount$Sponsor">

        INSERT INTO amount_list (
            amount_no,
            sponsor_name,
            amount,
            payment_date,
            status,
            remark,
            item_no
        )

        VALUES (
            #{amountNo},
            #{sponsorName},
            #{amount},
            #{paymentDate},
            #{status},
            #{remark},
            #{itemNo}
        )

    </insert>



    <!-- =========================================================
         16. 첨부파일 등록
         ========================================================= -->

    <insert id="insertAmountFile"
            parameterType="com.kh.workflow.amount.vo.Amount$File"
            useGeneratedKeys="true"
            keyProperty="amountattachmentNo">

        INSERT INTO amount_file (
            file_path,
            origin_name,
            change_name,
            updated_at,
            status,
            amount_no
        )

        VALUES (
            #{filePath},
            #{originName},
            #{changeName},
            NOW(),
            'Y',
            #{amountNo}
        )

    </insert>



    <!-- =========================================================
         17. 비용 기본정보 수정
         ========================================================= -->

    <update id="updateAmount"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET
            requested_amount = #{requestedAmount},
            amount_comment = #{amountComment},
            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         18. 승인 상태 변경
         ========================================================= -->

    <update id="updateApprovalStatus"
            parameterType="map">

        UPDATE amount

        SET
            status = #{status},

            approved_amount = #{approvedAmount},

            amount_comment = #{amountComment},

            approved_at =
                CASE
                    WHEN #{status} = 'A'
                    THEN NOW()
                    ELSE approved_at
                END,

            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         19. 비용 취소
         ========================================================= -->

    <update id="cancelAmount"
            parameterType="int">

        UPDATE amount

        SET
            status = 'C',
            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         20. 첨부파일 삭제
         ========================================================= -->

    <delete id="deleteFile"
            parameterType="int">

        DELETE FROM amount_file

        WHERE amountattachment_no = #{amountattachmentNo}

    </delete>



    <!-- =========================================================
         21. 지자체 지원금 삭제
         ========================================================= -->

    <delete id="deleteAmountSponsorByAmountNo"
            parameterType="int">

        DELETE FROM amount_list

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         22. 비용 항목 전체 삭제
         ========================================================= -->

    <delete id="deleteAmountItemsByAmountNo"
            parameterType="int">

        DELETE FROM amount_item

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         23. 통계 - 전체 요약
         ========================================================= -->

   <select id="getStatisticsSummary"
        resultType="map">

    SELECT

        COUNT(DISTINCT a.amount_no) AS totalCount,

        /* 모든 직원의 신청금액 */
        COALESCE(
            SUM(ai.amount),
            0
        ) AS totalRequestedAmount,

        /* 승인된 회사 지원금 */
        COALESCE(
            SUM(
                CASE
                    WHEN a.status = 'A'
                    THEN ai.item_approved_amount
                    ELSE 0
                END
            ),
            0
        ) AS totalApprovedAmount,

        /* 승인 */
        COUNT(
            DISTINCT CASE
                WHEN a.status = 'A'
                THEN a.amount_no
            END
        ) AS approvedCount,

        /* 검토 */
        COUNT(
            DISTINCT CASE
                WHEN a.status = 'R'
                THEN a.amount_no
            END
        ) AS reviewCount,

        /* 보류 */
        COUNT(
            DISTINCT CASE
                WHEN a.status = 'H'
                THEN a.amount_no
            END
        ) AS holdCount,

        /* 반려 */
        COUNT(
            DISTINCT CASE
                WHEN a.status = 'J'
                THEN a.amount_no
            END
        ) AS rejectedCount,

        /* 취소 */
        COUNT(
            DISTINCT CASE
                WHEN a.status = 'C'
                THEN a.amount_no
            END
        ) AS cancelledCount

    FROM amount a

    LEFT JOIN amount_item ai
        ON a.amount_no = ai.amount_no

</select>



    <!-- =========================================================
         24. 통계 - 부서별
         ========================================================= -->

   <select id="getDeptStatistics"
        resultType="map">

    SELECT

        d.dep_title AS departmentName,

        COALESCE(
            SUM(ai.item_approved_amount),
            0
        ) AS approvedAmount

    FROM amount a

    JOIN amount_item ai
      ON a.amount_no = ai.amount_no

    JOIN workcation_info w
      ON a.workcation_no = w.workcation_no

    JOIN employee e
      ON w.emp_no = e.emp_no

    JOIN department d
      ON e.dep_id = d.dep_id

    WHERE a.status = 'A'

    GROUP BY
        d.dep_id,
        d.dep_title

    ORDER BY approvedAmount DESC

</select>





    <!-- =========================================================
         25. 통계 - 월별
         ========================================================= -->

<select id="getMonthlyStatistics"
        resultType="map">

    SELECT

        DATE_FORMAT(
            a.approved_at,
            '%Y-%m'
        ) AS month,

        COALESCE(
            SUM(ai.item_approved_amount),
            0
        ) AS approvedAmount

    FROM amount a

    JOIN amount_item ai
      ON a.amount_no = ai.amount_no

    WHERE a.status = 'A'

      AND a.approved_at IS NOT NULL

    GROUP BY
        DATE_FORMAT(
            a.approved_at,
            '%Y-%m'
        )

    ORDER BY month ASC

</select>
















<select id="getItemStatistics"
        resultType="map">

    SELECT
        ai.amountamountitem_type AS itemType,
        COUNT(*) AS itemCount,
        COALESCE(SUM(ai.amount), 0) AS requestedAmount,
        COALESCE(SUM(ai.item_approved_amount), 0) AS approvedAmount

    FROM amount_item ai

    JOIN amount a
      ON ai.amount_no = a.amount_no

    WHERE a.status = 'A'

    GROUP BY
        ai.amountamountitem_type

    ORDER BY
        ai.amountamountitem_type

</select>


    <!-- =========================================================
         26. 통계 - 항목별
         
         DB 기준
         S = 숙박
         T = 교통
         E = 체험
         F = 식비
         V = 차량
         O = 기타
         ========================================================= -->

    <select id="getItemStatistics"
            resultType="map">

        SELECT

            ai.item_type AS itemType,

            COUNT(ai.item_no) AS itemCount,

            COALESCE(
                SUM(ai.cost),
                0
            ) AS totalAmount,

            COALESCE(
                SUM(
                    CASE
                        WHEN ai.item_approved = 'A'
                        THEN ai.cost
                        ELSE 0
                    END
                ),
                0
            ) AS approvedAmount

        FROM amount_item ai

        GROUP BY
            ai.item_type

        ORDER BY
            totalAmount DESC

    </select>
    
    <!-- =========================================================
         27. 관리자 대시보드 - (이번달)예산 소진율
         ========================================================= -->
    <select id="adminSelectBudgetExhaustionRate" resultType="int">
        SELECT COALESCE((SUM(a.approved_amount)/SUM(s.approved_amount)) * 100, 0)
        FROM support_list s
        JOIN amount_support a ON a.amount_no = s.amount_no
        WHERE EXTRACT(MONTH FROM CURRENT_TIMESTAMP) = EXTRACT(MONTH FROM a.approved_at)
          AND a.status = 'A'
    </select>
    
    <!-- =========================================================
         28. 관리자 대시보드 - 회사 부담금
         ========================================================= -->
    <select id="selectTotalBudget" resultType="int">
        SELECT COALESCE(SUM(a.approved_amount), 0)
          FROM amount_support a
         WHERE a.status = 'A'
    </select>
    
    <!-- =========================================================
         29. 관리자 대시보드 - 보유 지원금
         ========================================================= -->
    <select id="selectSupportFund" resultType="int">
        SELECT COALESCE(SUM(s.approved_amount), 0)
          FROM support_list s
    </select>
    
    <!-- =========================================================
         30. 관리자 대시보드 - 총 예산 대비 집행률
         ========================================================= -->
    <select id="selectBudgetData" resultType="int">
        SELECT COALESCE((SUM(a.approved_amount)/SUM(s.approved_amount)) * 100, 0)
          FROM support_list s
          JOIN amount_support a ON a.amount_no = s.amount_no
         WHERE a.status = 'A'
    </select>
    
    <!-- =========================================================
         31. 관리자 대시보드 - 항목별 지출 비중
         ========================================================= -->
    <select id="selectCategoryData" resultType="com.kh.workflow.dashboard.model.dto.ChartDataDto">
        SELECT CASE WHEN a.item_type = 'S' THEN '숙박'
        			WHEN a.item_type = 'T' THEN '교통'
        			WHEN a.item_type = 'E' THEN '체험'
        			WHEN a.item_type = 'F' THEN '식비'
        			WHEN a.item_type = 'V' THEN '차량'
        			ELSE '기타'
        		END AS name, COALESCE(SUM(a.item_amount), 0)
          FROM amount_item a
         GROUP BY a.item_type
    </select>
    
    <!-- =========================================================
         32. 관리자 대시보드 - 부서별 사용 예산
         ========================================================= -->
    <select id="selectDeptData" resultType="com.kh.workflow.dashboard.model.dto.ChartDataDto">
        SELECT d.dep_title, COALESCE(SUM(a.approved_amount), 0)
          FROM amount_support a
          JOIN workcation_info w ON w.workcation_no = a.workcation_no
          JOIN employee e ON e.emp_no = w.emp_no
          JOIN department d ON d.dep_id = e.dep_id
         WHERE a.status = 'A'
         GROUP BY d.dep_title
    </select>
    
    <!-- =========================================================
         33. 관리자 대시보드 - 총 비용
         ========================================================= -->
    <select id="selectTotalCost" resultType="int">
        SELECT COALESCE((SUM(s.approved_amount)-SUM(a.approved_amount)), 0)
          FROM support_list s
          JOIN amount_support a ON a.amount_no = s.amount_no
         WHERE a.status = 'A'
    </select>
    
    <!-- =========================================================
         34. 부서장 대시보드 - (부서)예산 소진율
         ========================================================= -->
    <select id="managerSelectBudgetExhaustionRate" parameterType="string" resultType="int">
        SELECT COALESCE((SUM(a.approved_amount)/SUM(s.approved_amount)) * 100, 0)
          FROM support_list s
          JOIN amount_support a ON a.amount_no = s.amount_no
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.dep_id = #{depId}
           AND a.status = 'A'
    </select>
    
    <!-- =========================================================
         35. 부서장 대시보드 - 정산대기 목록
         ========================================================= -->
    <select id="selectBalanceList" parameterType="string" resultType="com.kh.workflow.dashboard.model.dto.BalanceListDto">
        SELECT e.emp_name, e.emp_no, a.approved_amount, a.status
          FROM amount_support a
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.dep_id = #{depId}
    </select>
    
    <!-- =========================================================
         36. 사원 대시보드 - 남은 지원금
         ========================================================= -->
    <select id="selectAmountSupport" parameterType="int" resultType="int">
        SELECT COALESCE(SUM(s.approved_amount), 0)
          FROM amount_support a
          JOIN support_list s ON a.amount_no = s.amount_no
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.emp_no = #{empNo}
    </select>
    
    <!-- =========================================================
	     37. 사원 대시보드 - 사용 비용
	     ========================================================= -->
    <select id="selectUseAmount" parameterType="int" resultType="int">
        SELECT COALESCE(SUM(a.approved_amount), 0)
          FROM amount_support a
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.emp_no = #{empNo}
    </select>
    
</mapper>
