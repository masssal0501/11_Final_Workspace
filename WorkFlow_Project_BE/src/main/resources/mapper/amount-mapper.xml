<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.workflow.amount.dao.AmountDao">


    <!-- =========================================================
         1. Amount ResultMap
         ========================================================= -->

    <resultMap id="amountResultMap"
               type="com.kh.workflow.amount.vo.Amount">

        <id property="amountNo"
            column="amount_no"/>

        <result property="requestedAmount"
                column="requested_amount"/>

        <result property="approvedAmount"
                column="approved_amount"/>

        <result property="requestedAt"
                column="requested_at"/>

        <result property="approvedAt"
                column="approved_at"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

        <result property="amountComment"
                column="amount_comment"/>

        <result property="workcationNo"
                column="workcation_no"/>

        <result property="empName"
                column="emp_name"/>

    </resultMap>


    <!-- =========================================================
         2. Item ResultMap
         ========================================================= -->

    <resultMap id="itemResultMap"
               type="com.kh.workflow.amount.vo.Amount$Item">

        <id property="itemNo"
            column="item_no"/>

        <result property="cost"
                column="cost"/>

        <result property="itemType"
                column="item_type"/>

        <result property="itemDate"
                column="item_date"/>

        <result property="itemApproved"
                column="item_approved"/>

        <result property="itemDescription"
                column="item_description"/>

        <result property="amountNo"
                column="amount_no"/>

    </resultMap>


    <!-- =========================================================
         3. Sponsor ResultMap
         ========================================================= -->

    <resultMap id="sponsorResultMap"
               type="com.kh.workflow.amount.vo.Amount$Sponsor">

        <id property="amountListNo"
            column="amount_list_no"/>

        <result property="sponsorName"
                column="sponsor_name"/>

        <result property="amount"
                column="amount"/>

        <result property="paymentDate"
                column="payment_date"/>

        <result property="status"
                column="status"/>

        <result property="remark"
                column="remark"/>

        <result property="amountNo"
                column="amount_no"/>

    </resultMap>


    <!-- =========================================================
         4. File ResultMap
         ========================================================= -->

    <resultMap id="fileResultMap"
               type="com.kh.workflow.amount.vo.Amount$File">

        <id property="amountattachmentNo"
            column="amountattachment_no"/>

        <result property="filePath"
                column="file_path"/>

        <result property="originName"
                column="origin_name"/>

        <result property="changeName"
                column="change_name"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

        <result property="amountNo"
                column="amount_no"/>

    </resultMap>


    <!-- =========================================================
         5. 비용 신청 등록
         ========================================================= -->

    <insert id="insertAmount"
            parameterType="com.kh.workflow.amount.vo.Amount"
            useGeneratedKeys="true"
            keyProperty="amountNo"
            keyColumn="amount_no">

        INSERT INTO amount
        (
            requested_amount,
            approved_amount,
            requested_at,
            approved_at,
            created_at,
            updated_at,
            status,
            amount_comment,
            workcation_no
        )
        VALUES
        (
            #{requestedAmount},
            #{approvedAmount},
            #{requestedAt},
            #{approvedAt},
            CURRENT_TIMESTAMP,
            #{updatedAt},
            #{status},
            #{amountComment},
            #{workcationNo}
        )

    </insert>


    <!-- =========================================================
         6. 비용 상세 항목 등록
         ========================================================= -->

    <insert id="insertAmountItem"
            parameterType="com.kh.workflow.amount.vo.Amount$Item"
            useGeneratedKeys="true"
            keyProperty="itemNo"
            keyColumn="item_no">

        INSERT INTO amount_item
        (
            cost,
            item_type,
            item_date,
            item_approved,
            item_description,
            amount_no
        )
        VALUES
        (
            #{cost},
            #{itemType},
            #{itemDate},
            #{itemApproved},
            #{itemDescription},
            #{amountNo}
        )

    </insert>


    <!-- =========================================================
         7. 지원금 등록
         ========================================================= -->

    <insert id="insertAmountSponsor"
            parameterType="com.kh.workflow.amount.vo.Amount$Sponsor"
            useGeneratedKeys="true"
            keyProperty="amountListNo"
            keyColumn="amount_list_no">

        INSERT INTO amount_list
        (
            sponsor_name,
            amount,
            payment_date,
            status,
            remark,
            amount_no
        )
        VALUES
        (
            #{sponsorName},
            #{amount},
            #{paymentDate},
            #{status},
            #{remark},
            #{amountNo}
        )

    </insert>


    <!-- =========================================================
         8. 첨부파일 등록
         ========================================================= -->

    <insert id="insertAmountFile"
            parameterType="com.kh.workflow.amount.vo.Amount$File"
            useGeneratedKeys="true"
            keyProperty="amountattachmentNo"
            keyColumn="amountattachment_no">

        INSERT INTO amount_file
        (
            file_path,
            origin_name,
            change_name,
            updated_at,
            status,
            amount_no
        )
        VALUES
        (
            #{filePath},
            #{originName},
            #{changeName},
            CURRENT_TIMESTAMP,
            #{status},
            #{amountNo}
        )

    </insert>


    <!-- =========================================================
         9. 비용 상세 조회
         ========================================================= -->

    <select id="selectAmountById"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        WHERE a.amount_no = #{amountNo}

    </select>


    <!-- =========================================================
         10. 전체 비용 신청 개수
         ========================================================= -->

    <select id="getAmountListCount"
            resultType="int">

        SELECT COUNT(*)
        FROM amount

    </select>


    <!-- =========================================================
         11. 전체 비용 신청 목록
         =========================================================
         
         PageInfo
         ├── offset
         └── limit
         
         MySQL LIMIT 방식
         ========================================================= -->

    <select id="selectAmountList"
            parameterType="com.kh.workflow.common.model.vo.PageInfo"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        ORDER BY
            a.created_at DESC,
            a.amount_no DESC

        LIMIT #{offset}, #{limit}

    </select>


    <!-- =========================================================
         12. 워케이션별 비용 신청 개수
         ========================================================= -->

    <select id="getAmountCountByWorkcationNo"
            parameterType="int"
            resultType="int">

        SELECT COUNT(*)

        FROM amount

        WHERE workcation_no = #{workcationNo}

    </select>


    <!-- =========================================================
         13. 워케이션별 비용 신청 목록
         =========================================================
         
         DAO
         @Param("workcationNo") int workcationNo
         @Param("pi") PageInfo pi
         
         XML
         #{workcationNo}
         #{pi.offset}
         #{pi.limit}
         
         ========================================================= -->

    <select id="selectAmountListByWorkcationNo"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        WHERE a.workcation_no = #{workcationNo}

        ORDER BY
            a.created_at DESC,
            a.amount_no DESC

        LIMIT #{pi.offset}, #{pi.limit}

    </select>


    <!-- =========================================================
         14. 비용 상세 항목 조회
         ========================================================= -->

    <select id="selectAmountItemsByAmountNo"
            parameterType="int"
            resultMap="itemResultMap">

        SELECT
            item_no,
            cost,
            item_type,
            item_date,
            item_approved,
            item_description,
            amount_no

        FROM amount_item

        WHERE amount_no = #{amountNo}

        ORDER BY item_no ASC

    </select>


    <!-- =========================================================
         15. 지원금 조회
         ========================================================= -->

    <select id="selectSponsorsByAmountNo"
            parameterType="int"
            resultMap="sponsorResultMap">

        SELECT
            amount_list_no,
            sponsor_name,
            amount,
            payment_date,
            status,
            remark,
            amount_no

        FROM amount_list

        WHERE amount_no = #{amountNo}

        ORDER BY amount_list_no ASC

    </select>


    <!-- =========================================================
         16. 첨부파일 조회
         ========================================================= -->

    <select id="selectAmountFilesByAmountNo"
            parameterType="int"
            resultMap="fileResultMap">

        SELECT
            amountattachment_no,
            file_path,
            origin_name,
            change_name,
            updated_at,
            status,
            amount_no

        FROM amount_file

        WHERE amount_no = #{amountNo}

          AND status = 'Y'

        ORDER BY amountattachment_no ASC

    </select>


    <!-- =========================================================
         17. 비용 신청 수정
         ========================================================= -->

    <update id="updateAmount"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET
            requested_amount = #{requestedAmount},
            amount_comment = #{amountComment},
            updated_at = CURRENT_TIMESTAMP

        WHERE amount_no = #{amountNo}

    </update>


    <!-- =========================================================
         18. 결재 상태 변경
         ========================================================= -->

    <update id="updateApprovalStatus"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET
            status = #{status},

            approved_amount = #{approvedAmount},

            amount_comment = #{amountComment},

            approved_at =
                CASE
                    WHEN #{status} = 'A'
                    THEN CURRENT_TIMESTAMP
                    ELSE approved_at
                END,

            updated_at = CURRENT_TIMESTAMP

        WHERE amount_no = #{amountNo}

    </update>


    <!-- =========================================================
         19. 첨부파일 삭제
         ========================================================= -->

    <delete id="deleteFile"
            parameterType="int">

        DELETE FROM amount_file

        WHERE amountattachment_no = #{amountattachmentNo}

    </delete>


    <!-- =========================================================
         20. 비용 신청 취소
         ========================================================= -->

    <update id="cancelAmount"
            parameterType="int">

        UPDATE amount

        SET
            status = 'C',
            updated_at = CURRENT_TIMESTAMP

        WHERE amount_no = #{amountNo}

          AND status NOT IN
          (
              'A',
              'J',
              'C'
          )

    </update>


    <!-- =========================================================
         21. 기존 Item 삭제
         ========================================================= -->

    <delete id="deleteAmountItemsByAmountNo"
            parameterType="int">

        DELETE FROM amount_item

        WHERE amount_no = #{amountNo}

    </delete>


    <!-- =========================================================
         22. 기존 Sponsor 삭제
         ========================================================= -->

    <delete id="deleteAmountSponsorsByAmountNo"
            parameterType="int">

        DELETE FROM amount_list

        WHERE amount_no = #{amountNo}

    </delete>


    <!-- =========================================================
         23. 통계 - 전체 요약
         ========================================================= -->

    <select id="getStatisticsSummary"
            resultType="map">

        SELECT

            COUNT(*) AS totalCount,

            COALESCE(
                SUM(requested_amount),
                0
            ) AS totalRequestedAmount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'A'
                        THEN approved_amount
                        ELSE 0
                    END
                ),
                0
            ) AS totalApprovedAmount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'R'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS reviewCount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'A'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS approvedCount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'H'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS holdCount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'J'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS rejectedCount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'C'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS cancelledCount

        FROM amount

    </select>


    <!-- =========================================================
         24. 통계 - 부서별
         ========================================================= -->

    <select id="getDeptStatistics"
            resultType="map">

        SELECT

            d.dep_id AS depId,

            d.dep_title AS depTitle,

            COUNT(a.amount_no) AS amountCount,

            COALESCE(
                SUM(a.requested_amount),
                0
            ) AS requestedAmount,

            COALESCE(
                SUM(
                    CASE
                        WHEN a.status = 'A'
                        THEN a.approved_amount
                        ELSE 0
                    END
                ),
                0
            ) AS approvedAmount

        FROM department d

        LEFT JOIN employee e
            ON d.dep_id = e.dep_id

        LEFT JOIN workcation_info w
            ON e.emp_no = w.emp_no

        LEFT JOIN amount a
            ON w.workcation_no = a.workcation_no

        GROUP BY
            d.dep_id,
            d.dep_title

        ORDER BY
            d.dep_id

    </select>


    <!-- =========================================================
         25. 통계 - 월별
         ========================================================= -->

    <select id="getMonthlyStatistics"
            resultType="map">

        SELECT

            DATE_FORMAT(
                requested_at,
                '%Y-%m'
            ) AS month,

            COUNT(*) AS amountCount,

            COALESCE(
                SUM(requested_amount),
                0
            ) AS requestedAmount,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'A'
                        THEN approved_amount
                        ELSE 0
                    END
                ),
                0
            ) AS approvedAmount

        FROM amount

        GROUP BY
            DATE_FORMAT(
                requested_at,
                '%Y-%m'
            )

        ORDER BY
            month ASC

    </select>


    <!-- =========================================================
         26. 통계 - 비용 항목별
         ========================================================= -->

    <select id="getItemStatistics"
            resultType="map">

        SELECT

            ai.item_type AS itemType,

            COUNT(ai.item_no) AS itemCount,

            COALESCE(
                SUM(ai.cost),
                0
            ) AS totalAmount,

            COALESCE(
                SUM(
                    CASE
                        WHEN ai.item_approved = 'A'
                        THEN ai.cost
                        ELSE 0
                    END
                ),
                0
            ) AS approvedAmount

        FROM amount_item ai

        GROUP BY
            ai.item_type

        ORDER BY
            totalAmount DESC

    </select>
    
    <!-- =========================================================
         27. 관리자 대시보드 - (이번달)예산 소진율
         ========================================================= -->
    <select id="adminSelectBudgetExhaustionRate" resultType="int">
        SELECT COALESCE((SUM(a.approved_amount)/SUM(s.approved_amount)) * 100, 0)
        FROM support_list s
        JOIN amount_support a ON a.amount_no = s.amount_no
        WHERE EXTRACT(MONTH FROM CURRENT_TIMESTAMP) = EXTRACT(MONTH FROM a.approved_at)
          AND a.status = 'A'
    </select>
    
    <!-- =========================================================
         28. 관리자 대시보드 - 회사 부담금
         ========================================================= -->
    <select id="selectTotalBudget" resultType="int">
        SELECT COALESCE(SUM(a.approved_amount), 0)
          FROM amount_support a
         WHERE a.status = 'A'
    </select>
    
    <!-- =========================================================
         29. 관리자 대시보드 - 보유 지원금
         ========================================================= -->
    <select id="selectSupportFund" resultType="int">
        SELECT COALESCE(SUM(s.approved_amount), 0)
          FROM support_list s
    </select>
    
    <!-- =========================================================
         30. 관리자 대시보드 - 총 예산 대비 집행률
         ========================================================= -->
    <select id="selectBudgetData" resultType="int">
        SELECT COALESCE((SUM(a.approved_amount)/SUM(s.approved_amount)) * 100, 0)
          FROM support_list s
          JOIN amount_support a ON a.amount_no = s.amount_no
         WHERE a.status = 'A'
    </select>
    
    <!-- =========================================================
         31. 관리자 대시보드 - 항목별 지출 비중
         ========================================================= -->
    <select id="selectCategoryData" resultType="com.kh.workflow.dashboard.model.dto.ChartDataDto">
        SELECT CASE WHEN a.item_type = 'S' THEN '숙박'
        			WHEN a.item_type = 'T' THEN '교통'
        			WHEN a.item_type = 'E' THEN '체험'
        			WHEN a.item_type = 'F' THEN '식비'
        			WHEN a.item_type = 'V' THEN '차량'
        			ELSE '기타'
        		END AS name, COALESCE(SUM(a.item_amount), 0)
          FROM amount_item a
         GROUP BY a.item_type
    </select>
    
    <!-- =========================================================
         32. 관리자 대시보드 - 부서별 사용 예산
         ========================================================= -->
    <select id="selectDeptData" resultType="com.kh.workflow.dashboard.model.dto.ChartDataDto">
        SELECT d.dep_title, COALESCE(SUM(a.approved_amount), 0)
          FROM amount_support a
          JOIN workcation_info w ON w.workcation_no = a.workcation_no
          JOIN employee e ON e.emp_no = w.emp_no
          JOIN department d ON d.dep_id = e.dep_id
         WHERE a.status = 'A'
         GROUP BY d.dep_title
    </select>
    
    <!-- =========================================================
         33. 관리자 대시보드 - 총 비용
         ========================================================= -->
    <select id="selectTotalCost" resultType="int">
        SELECT COALESCE((SUM(s.approved_amount)-SUM(a.approved_amount)), 0)
          FROM support_list s
          JOIN amount_support a ON a.amount_no = s.amount_no
         WHERE a.status = 'A'
    </select>
    
    <!-- =========================================================
         34. 부서장 대시보드 - (부서)예산 소진율
         ========================================================= -->
    <select id="managerSelectBudgetExhaustionRate" parameterType="string" resultType="int">
        SELECT COALESCE((SUM(a.approved_amount)/SUM(s.approved_amount)) * 100, 0)
          FROM support_list s
          JOIN amount_support a ON a.amount_no = s.amount_no
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.dep_id = #{depId}
           AND a.status = 'A'
    </select>
    
    <!-- =========================================================
         35. 부서장 대시보드 - 정산대기 목록
         ========================================================= -->
    <select id="selectBalanceList" parameterType="string" resultType="com.kh.workflow.dashboard.model.dto.BalanceListDto">
        SELECT e.emp_name, e.emp_no, a.approved_amount, a.status
          FROM amount_support a
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.dep_id = #{depId}
    </select>
    
    <!-- =========================================================
         36. 사원 대시보드 - 남은 지원금
         ========================================================= -->
    <select id="selectAmountSupport" parameterType="int" resultType="int">
        SELECT COALESCE(SUM(s.approved_amount), 0)
          FROM amount_support a
          JOIN support_list s ON a.amount_no = s.amount_no
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.emp_no = #{empNo}
    </select>
    
    <!-- =========================================================
	     37. 사원 대시보드 - 사용 비용
	     ========================================================= -->
    <select id="selectUseAmount" parameterType="int" resultType="int">
        SELECT COALESCE(SUM(a.approved_amount), 0)
          FROM amount_support a
          JOIN workcation_info w ON a.workcation_no = w.workcation_no
          JOIN employee e ON w.emp_no = e.emp_no
         WHERE e.emp_no = #{empNo}
    </select>
    
</mapper>