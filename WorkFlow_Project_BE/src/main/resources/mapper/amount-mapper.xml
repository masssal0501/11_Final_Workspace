<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.workflow.amount.dao.AmountDao">


    <!-- =========================================================
         1. RESULT MAP
         ========================================================= -->

    <!-- =========================================================
         Amount 기본 정보
         amount
         ========================================================= -->
    <resultMap id="amountResultMap"
               type="com.kh.workflow.amount.vo.Amount">

        <id property="amountNo"
            column="amount_no"/>

        <result property="requestedAmount"
                 column="requested_amount"/>

        <result property="approvedAmount"
                 column="approved_amount"/>

        <result property="requestedAt"
                 column="requested_at"/>

        <result property="approvedAt"
                 column="approved_at"/>

        <result property="createdAt"
                 column="created_at"/>

        <result property="updatedAt"
                 column="updated_at"/>

        <result property="status"
                 column="status"/>

        <result property="amountComment"
                 column="amount_comment"/>

        <result property="workcationNo"
                 column="workcation_no"/>

        <result property="empName"
                 column="emp_name"/>


        <!-- =====================================================
             비용 항목
             amount_item.amount = 회사 지원금
             ===================================================== -->

        <collection property="itemList"
                    ofType="com.kh.workflow.amount.vo.Amount$Item"
                    column="amount_no"
                    select="selectItemsByAmountNo"/>


        <!-- =====================================================
             지자체 지원금
             amount_list.amount = 지자체 지원금
             ===================================================== -->

        <collection property="sponsorList"
                    ofType="com.kh.workflow.amount.vo.Amount$Sponsor"
                    column="amount_no"
                    select="selectSponsorsByAmountNo"/>


        <!-- =====================================================
             첨부파일
             ===================================================== -->

        <collection property="fileList"
                    ofType="com.kh.workflow.amount.vo.Amount$File"
                    column="amount_no"
                    select="selectFilesByAmountNo"/>

    </resultMap>


    <!-- =========================================================
         비용 항목 ResultMap
         ========================================================= -->

    <resultMap id="itemResultMap"
               type="com.kh.workflow.amount.vo.Amount$Item">

        <id property="itemNo"
            column="item_no"/>

        <!-- DB 실제 컬럼명 -->
        <result property="itemType"
                column="amountamountitem_type"/>

        <result property="itemDate"
                column="item_date"/>

        <result property="itemApproved"
                column="item_approved"/>

        <result property="itemDescription"
                column="item_description"/>

        <result property="amountNo"
                column="amount_no"/>

        <!-- 중요:
             amount_item.amount = 회사 지원금
             cost가 아님 -->
        <result property="amount"
                column="item_amount"/>

    </resultMap>


    <!-- =========================================================
         지자체 지원금 ResultMap
         ========================================================= -->

    <resultMap id="sponsorResultMap"
               type="com.kh.workflow.amount.vo.Amount$Sponsor">

        <id property="amountListNo"
            column="amount_list_no"/>

        <result property="amountNo"
                column="amount_no"/>

        <result property="sponsorName"
                column="sponsor_name"/>

        <!-- amount_list.amount = 지자체 지원금 -->
        <result property="amount"
                column="sponsor_amount"/>

        <result property="paymentDate"
                column="payment_date"/>

        <result property="status"
                column="status"/>

        <result property="remark"
                column="remark"/>

        <result property="itemNo"
                column="item_no"/>

    </resultMap>


    <!-- =========================================================
         첨부파일 ResultMap
         ========================================================= -->

    <resultMap id="fileResultMap"
               type="com.kh.workflow.amount.vo.Amount$File">

        <id property="amountattachmentNo"
            column="amountattachment_no"/>

        <result property="filePath"
                column="file_path"/>

        <result property="originName"
                column="origin_name"/>

        <result property="changeName"
                column="change_name"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

        <result property="amountNo"
                column="amount_no"/>

    </resultMap>



    <!-- =========================================================
         2. 비용 상세 조회
         ========================================================= -->

    <!-- =========================================================
         amount_no로 비용 상세 1건 조회
         ========================================================= -->

    <select id="selectAmountById"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,

            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        WHERE a.amount_no = #{amountNo}

    </select>



    <!-- =========================================================
         3. 비용 항목 조회
         
         amount_item
         
         amount_item.amount = 회사 지원금
         ========================================================= -->

    <select id="selectItemsByAmountNo"
            parameterType="int"
            resultMap="itemResultMap">

        SELECT
            ai.item_no,
            ai.amountamountitem_type,
            ai.item_date,
            ai.item_approved,
            ai.item_description,
            ai.amount_no,

            ai.amount AS item_amount

        FROM amount_item ai

        WHERE ai.amount_no = #{amountNo}

        ORDER BY
            ai.item_date ASC,
            ai.item_no ASC

    </select>



    <!-- =========================================================
         4. 지자체 지원금 조회
         
         amount_list
         ========================================================= -->

    <select id="selectSponsorsByAmountNo"
            parameterType="int"
            resultMap="sponsorResultMap">

        SELECT
            al.amount_list_no,
            al.amount_no,
            al.sponsor_name,

            al.amount AS sponsor_amount,

            al.payment_date,
            al.status,
            al.remark,
            al.item_no

        FROM amount_list al

        WHERE al.amount_no = #{amountNo}

        ORDER BY
            al.amount_list_no ASC

    </select>



    <!-- =========================================================
         5. 첨부파일 조회
         ========================================================= -->

    <select id="selectFilesByAmountNo"
            parameterType="int"
            resultMap="fileResultMap">

        SELECT
            af.amountattachment_no,
            af.file_path,
            af.origin_name,
            af.change_name,
            af.updated_at,
            af.status,
            af.amount_no

        FROM amount_file af

        WHERE af.amount_no = #{amountNo}

          AND af.status = 'Y'

        ORDER BY
            af.amountattachment_no ASC

    </select>



    <!-- =========================================================
         6. 워케이션별 비용 목록
         ========================================================= -->

    <select id="selectAmountListByWorkcationNo"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,

            e.emp_name

        FROM amount a

        INNER JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        INNER JOIN employee e
            ON w.emp_no = e.emp_no

        WHERE a.workcation_no = #{workcationNo}

        ORDER BY
            a.created_at DESC,
            a.amount_no DESC

    </select>



    <!-- =========================================================
         7. 비용 신청 등록
         ========================================================= -->

    <insert id="insertAmount"
            parameterType="com.kh.workflow.amount.vo.Amount"
            useGeneratedKeys="true"
            keyProperty="amountNo"
            keyColumn="amount_no">

        INSERT INTO amount (
            requested_amount,
            approved_amount,
            requested_at,
            created_at,
            status,
            amount_comment,
            workcation_no
        )

        VALUES (
            #{requestedAmount},
            #{approvedAmount},
            #{requestedAt},
            NOW(),
            #{status},
            #{amountComment},
            #{workcationNo}
        )

    </insert>



    <!-- =========================================================
         8. 비용 항목 등록
         
         amount_item.amount
         = 회사 지원금
         ========================================================= -->

    <insert id="insertAmountItem"
            parameterType="com.kh.workflow.amount.vo.Amount$Item"
            useGeneratedKeys="true"
            keyProperty="itemNo"
            keyColumn="item_no">

        INSERT INTO amount_item (
            amountamountitem_type,
            item_date,
            item_approved,
            item_description,
            amount_no,
            amount
        )

        VALUES (
            #{itemType},
            #{itemDate},
            #{itemApproved},
            #{itemDescription},
            #{amountNo},
            #{amount}
        )

    </insert>



    <!-- =========================================================
         9. 지자체 지원금 등록
         
         amount_list.amount
         = 지자체 지원금
         ========================================================= -->

    <insert id="insertAmountList"
            parameterType="com.kh.workflow.amount.vo.Amount$Sponsor"
            useGeneratedKeys="true"
            keyProperty="amountListNo"
            keyColumn="amount_list_no">

        INSERT INTO amount_list (
            amount_no,
            sponsor_name,
            amount,
            payment_date,
            status,
            remark,
            item_no
        )

        VALUES (
            #{amountNo},
            #{sponsorName},
            #{amount},
            #{paymentDate},
            #{status},
            #{remark},
            #{itemNo}
        )

    </insert>



    <!-- =========================================================
         10. 첨부파일 등록
         ========================================================= -->

    <insert id="insertAmountFile"
            parameterType="com.kh.workflow.amount.vo.Amount$File"
            useGeneratedKeys="true"
            keyProperty="amountattachmentNo"
            keyColumn="amountattachment_no">

        INSERT INTO amount_file (
            file_path,
            origin_name,
            change_name,
            updated_at,
            status,
            amount_no
        )

        VALUES (
            #{filePath},
            #{originName},
            #{changeName},
            NOW(),
            'Y',
            #{amountNo}
        )

    </insert>



    <!-- =========================================================
         11. 비용 항목 수정
         ========================================================= -->

    <update id="updateAmountItem"
            parameterType="com.kh.workflow.amount.vo.Amount$Item">

        UPDATE amount_item

        SET
            amountamountitem_type = #{itemType},
            item_date = #{itemDate},
            item_description = #{itemDescription},
            amount = #{amount}

        WHERE item_no = #{itemNo}

          AND amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         12. 지자체 지원금 수정
         ========================================================= -->

    <update id="updateAmountList"
            parameterType="com.kh.workflow.amount.vo.Amount$Sponsor">

        UPDATE amount_list

        SET
            sponsor_name = #{sponsorName},
            amount = #{amount},
            payment_date = #{paymentDate},
            status = #{status},
            remark = #{remark},
            item_no = #{itemNo}

        WHERE amount_list_no = #{amountListNo}

          AND amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         13. 비용 기본정보 수정
         ========================================================= -->

    <update id="updateAmount"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET
            requested_amount = #{requestedAmount},
            updated_at = NOW(),
            amount_comment = #{amountComment}

        WHERE amount_no = #{amountNo}

          AND status IN ('R', 'H')

    </update>



    <!-- =========================================================
         14. 승인 처리
         
         A : 승인
         H : 보류
         J : 반려
         ========================================================= -->

    <update id="updateApprovalStatus"
            parameterType="map">

        UPDATE amount

        SET
            status = #{status},

            approved_amount =
                CASE
                    WHEN #{status} = 'A'
                    THEN #{approvedAmount}
                    ELSE approved_amount
                END,

            amount_comment = #{comment},

            approved_at =
                CASE
                    WHEN #{status} = 'A'
                    THEN NOW()
                    ELSE approved_at
                END,

            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         15. 취소
         ========================================================= -->

    <update id="cancelAmount"
            parameterType="int">

        UPDATE amount

        SET
            status = 'C',
            updated_at = NOW()

        WHERE amount_no = #{amountNo}

          AND status IN ('R', 'H')

    </update>



    <!-- =========================================================
         16. 승인 후 지자체 지원금 등록
         ========================================================= -->

    <insert id="insertSponsor"
            parameterType="map"
            useGeneratedKeys="true"
            keyProperty="amountListNo"
            keyColumn="amount_list_no">

        INSERT INTO amount_list (
            amount_no,
            sponsor_name,
            amount,
            payment_date,
            status,
            remark,
            item_no
        )

        VALUES (
            #{amountNo},
            #{sponsorName},
            #{sponsorAmount},
            #{paymentDate},
            #{sponsorStatus},
            #{remark},
            #{itemNo}
        )

    </insert>



    <!-- =========================================================
         17. 기존 지자체 지원금 삭제
         ========================================================= -->

    <delete id="deleteSponsorsByAmountNo"
            parameterType="int">

        DELETE FROM amount_list

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         18. 기존 비용 항목 삭제
         ========================================================= -->

    <delete id="deleteItemsByAmountNo"
            parameterType="int">

        DELETE FROM amount_item

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         19. 기존 첨부파일 삭제
         ========================================================= -->

    <update id="deleteFilesByAmountNo"
            parameterType="int">

        UPDATE amount_file

        SET
            status = 'N'

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         20. 승인 + 지자체 지원금
         
         amount
            approved_amount = 최종 승인 금액
         
         amount_item.amount
            회사 지원금
         
         amount_list.amount
            지자체 지원금
         ========================================================= -->

    <update id="updateApproval"
            parameterType="map">

        UPDATE amount

        SET
            status = #{status},
            approved_amount = #{approvedAmount},
            amount_comment = #{comment},
            approved_at =
                CASE
                    WHEN #{status} = 'A'
                    THEN NOW()
                    ELSE approved_at
                END,
            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         21. 특정 amount의 회사 지원금 합계
         
         amount_item.amount
         ========================================================= -->

    <select id="selectCompanySupportAmount"
            parameterType="int"
            resultType="int">

        SELECT
            COALESCE(SUM(ai.amount), 0)

        FROM amount_item ai

        WHERE ai.amount_no = #{amountNo}

    </select>



    <!-- =========================================================
         22. 특정 amount의 지자체 지원금 합계
         
         amount_list.amount
         ========================================================= -->

    <select id="selectLocalSupportAmount"
            parameterType="int"
            resultType="int">

        SELECT
            COALESCE(SUM(al.amount), 0)

        FROM amount_list al

        WHERE al.amount_no = #{amountNo}

    </select>



    <!-- =========================================================
         23. 특정 amount 전체 지원금
         
         회사 지원금
         +
         지자체 지원금
         ========================================================= -->

    <select id="selectTotalSupportAmount"
            parameterType="int"
            resultType="int">

        SELECT
            (
                SELECT COALESCE(SUM(ai.amount), 0)
                FROM amount_item ai
                WHERE ai.amount_no = #{amountNo}
            )
            +
            (
                SELECT COALESCE(SUM(al.amount), 0)
                FROM amount_list al
                WHERE al.amount_no = #{amountNo}
            )

    </select>



    <!-- =========================================================
         24. 회사 지원금 항목별 통계
         ========================================================= -->

    <select id="selectCompanySupportStatistics"
            resultType="map">

        SELECT
            ai.amountamountitem_type AS item_type,

            COALESCE(SUM(ai.amount), 0) AS amount

        FROM amount_item ai

        INNER JOIN amount a
            ON ai.amount_no = a.amount_no

        WHERE a.status = 'A'

        GROUP BY
            ai.amountamountitem_type

        ORDER BY
            ai.amountamountitem_type

    </select>



    <!-- =========================================================
         25. 지자체 지원금 통계
         ========================================================= -->

    <select id="selectLocalSupportStatistics"
            resultType="map">

        SELECT
            al.sponsor_name,

            COALESCE(SUM(al.amount), 0) AS amount

        FROM amount_list al

        INNER JOIN amount a
            ON al.amount_no = a.amount_no

        WHERE a.status = 'A'

        GROUP BY
            al.sponsor_name

        ORDER BY
            al.sponsor_name

    </select>



    <!-- =========================================================
         26. 전체 승인 금액
         ========================================================= -->

    <select id="selectTotalApprovedAmount"
            resultType="long">

        SELECT
            COALESCE(SUM(approved_amount), 0)

        FROM amount

        WHERE status = 'A'

    </select>



    <!-- =========================================================
         27. 평균 승인 금액
         ========================================================= -->

    <select id="selectAverageApprovedAmount"
            resultType="double">

        SELECT
            COALESCE(AVG(approved_amount), 0)

        FROM amount

        WHERE status = 'A'

    </select>



    <!-- =========================================================
         28. 월별 승인 금액
         ========================================================= -->

    <select id="selectMonthlyApprovedAmount"
            resultType="map">

        SELECT
            DATE_FORMAT(approved_at, '%Y-%m') AS month,

            COALESCE(SUM(approved_amount), 0) AS amount

        FROM amount

        WHERE status = 'A'

          AND approved_at IS NOT NULL

        GROUP BY
            DATE_FORMAT(approved_at, '%Y-%m')

        ORDER BY
            month ASC

    </select>



    <!-- =========================================================
         29. 부서별 승인 금액
         ========================================================= -->

    <select id="selectDepartmentApprovedAmount"
            resultType="map">

        SELECT
            d.dep_id,
            d.dep_title,

            COALESCE(SUM(a.approved_amount), 0) AS amount

        FROM amount a

        INNER JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        INNER JOIN employee e
            ON w.emp_no = e.emp_no

        INNER JOIN department d
            ON e.dep_id = d.dep_id

        WHERE a.status = 'A'

        GROUP BY
            d.dep_id,
            d.dep_title

        ORDER BY
            d.dep_id

    </select>



    <!-- =========================================================
         30. 회사 지원금 + 지자체 지원금 전체 통계
         ========================================================= -->

    <select id="selectSupportStatistics"
            resultType="map">

        SELECT

            (
                SELECT
                    COALESCE(SUM(ai.amount), 0)

                FROM amount_item ai

                INNER JOIN amount a2
                    ON ai.amount_no = a2.amount_no

                WHERE a2.status = 'A'

            ) AS company_support,

            (

                SELECT
                    COALESCE(SUM(al.amount), 0)

                FROM amount_list al

                INNER JOIN amount a3
                    ON al.amount_no = a3.amount_no

                WHERE a3.status = 'A'

            ) AS local_support

    </select>



    <!-- =========================================================
         31. 전체 비용 통계
         ========================================================= -->

    <select id="selectFullStatistics"
            resultType="map">

        SELECT

            /* 총 승인 금액 */
            (
                SELECT
                    COALESCE(SUM(a.approved_amount), 0)

                FROM amount a

                WHERE a.status = 'A'

            ) AS totalApproved,

            /* 평균 승인 금액 */
            (
                SELECT
                    COALESCE(AVG(a.approved_amount), 0)

                FROM amount a

                WHERE a.status = 'A'

            ) AS avgApproved,

            /* 회사 지원금 */
            (
                SELECT
                    COALESCE(SUM(ai.amount), 0)

                FROM amount_item ai

                INNER JOIN amount a2
                    ON ai.amount_no = a2.amount_no

                WHERE a2.status = 'A'

            ) AS companySupport,

            /* 지자체 지원금 */
            (
                SELECT
                    COALESCE(SUM(al.amount), 0)

                FROM amount_list al

                INNER JOIN amount a3
                    ON al.amount_no = a3.amount_no

                WHERE a3.status = 'A'

            ) AS localSupport

    </select>



    <!-- =========================================================
         32. 비용 신청 개수
         ========================================================= -->

    <select id="selectAmountCountByWorkcationNo"
            parameterType="int"
            resultType="int">

        SELECT
            COUNT(*)

        FROM amount

        WHERE workcation_no = #{workcationNo}

    </select>



    <!-- =========================================================
         33. 상태별 비용 개수
         ========================================================= -->

    <select id="selectAmountCountByStatus"
            resultType="map">

        SELECT
            status,
            COUNT(*) AS count

        FROM amount

        GROUP BY
            status

        ORDER BY
            status

    </select>


</mapper>

