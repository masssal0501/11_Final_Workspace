<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.workflow.amount.dao.AmountDao">


    <!-- =========================================================
         1. RESULT MAP
         ========================================================= -->

    <!-- =========================================================
         Amount 기본 정보
         ========================================================= -->

    <resultMap id="amountResultMap"
               type="com.kh.workflow.amount.vo.Amount">

        <id property="amountNo"
            column="amount_no"/>

        <result property="requestedAmount"
                column="requested_amount"/>

        <result property="approvedAmount"
                column="approved_amount"/>

        <result property="requestedAt"
                column="requested_at"/>

        <result property="approvedAt"
                column="approved_at"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

        <result property="amountComment"
                column="amount_comment"/>

        <result property="workcationNo"
                column="workcation_no"/>

        <!-- 조회용 employee.emp_name -->
        <result property="empName"
                column="emp_name"/>


        <!-- 회사 지원금 -->
        <collection property="itemList"
                    ofType="com.kh.workflow.amount.vo.Amount$Item"
                    column="amount_no"
                    select="selectAmountItemsByAmountNo"/>


        <!-- 지자체 지원금 -->
        <collection property="sponsorList"
                    ofType="com.kh.workflow.amount.vo.Amount$Sponsor"
                    column="amount_no"
                    select="selectSponsorsByAmountNo"/>


        <!-- 첨부파일 -->
        <collection property="fileList"
                    ofType="com.kh.workflow.amount.vo.Amount$File"
                    column="amount_no"
                    select="selectAmountFilesByAmountNo"/>

    </resultMap>


    <!-- =========================================================
         비용 상세 항목 ResultMap
         ========================================================= -->

    <resultMap id="itemResultMap"
               type="com.kh.workflow.amount.vo.Amount$Item">

        <id property="itemNo"
            column="item_no"/>

        <!-- DB 실제 컬럼명 -->
        <result property="itemType"
                column="amountamountitem_type"/>

        <result property="itemDate"
                column="item_date"/>

        <result property="itemApproved"
                column="item_approved"/>

        <result property="itemDescription"
                column="item_description"/>

        <result property="amountNo"
                column="amount_no"/>

        <!-- DB amount_item.amount -->
        <result property="amount"
                column="amount"/>

    </resultMap>


    <!-- =========================================================
         지자체 지원금 ResultMap
         ========================================================= -->

    <resultMap id="sponsorResultMap"
               type="com.kh.workflow.amount.vo.Amount$Sponsor">

        <id property="amountListNo"
            column="amount_list_no"/>

        <result property="amountNo"
                column="amount_no"/>

        <result property="sponsorName"
                column="sponsor_name"/>

        <!-- DB amount_list.amount -->
        <result property="amount"
                column="amount"/>

        <result property="paymentDate"
                column="payment_date"/>

        <result property="status"
                column="status"/>

        <result property="remark"
                column="remark"/>

        <result property="itemNo"
                column="item_no"/>

    </resultMap>


    <!-- =========================================================
         첨부파일 ResultMap
         ========================================================= -->

    <resultMap id="fileResultMap"
               type="com.kh.workflow.amount.vo.Amount$File">

        <id property="amountattachmentNo"
            column="amountattachment_no"/>

        <result property="filePath"
                column="file_path"/>

        <result property="originName"
                column="origin_name"/>

        <result property="changeName"
                column="change_name"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

        <result property="amountNo"
                column="amount_no"/>

    </resultMap>



    <!-- =========================================================
         2. 전체 비용 신청 개수
         
         DAO:
         int getAmountListCount();
         ========================================================= -->

    <select id="getAmountListCount"
            resultType="int">

        SELECT COUNT(*)
        FROM amount

    </select>



    <!-- =========================================================
         3. 전체 비용 신청 목록
         
         DAO:
         List<Amount> selectAmountList(PageInfo pi);
         
         RowBounds를 Service/Controller에서 사용하는 경우
         SQL에 LIMIT를 작성하지 않는다.
         ========================================================= -->

    <select id="selectAmountList"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        ORDER BY
            a.created_at DESC,
            a.amount_no DESC

    </select>



    <!-- =========================================================
         4. 비용 상세 조회
         
         DAO:
         Amount selectAmountById(int amountNo);
         ========================================================= -->

    <select id="selectAmountById"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        WHERE a.amount_no = #{amountNo}

    </select>



    <!-- =========================================================
         5. 비용 상세 항목 조회
         
         DAO:
         List<Amount.Item> selectAmountItemsByAmountNo(int amountNo);
         ========================================================= -->

    <select id="selectAmountItemsByAmountNo"
            parameterType="int"
            resultMap="itemResultMap">

        SELECT
            ai.item_no,
            ai.amountamountitem_type,
            ai.item_date,
            ai.item_approved,
            ai.item_description,
            ai.amount_no,
            ai.amount

        FROM amount_item ai

        WHERE ai.amount_no = #{amountNo}

        ORDER BY
            ai.item_date ASC,
            ai.item_no ASC

    </select>



    <!-- =========================================================
         6. 지자체 지원금 조회
         
         DAO:
         List<Amount.Sponsor> selectSponsorsByAmountNo(int amountNo);
         ========================================================= -->

    <select id="selectSponsorsByAmountNo"
            parameterType="int"
            resultMap="sponsorResultMap">

        SELECT
            al.amount_list_no,
            al.amount_no,
            al.sponsor_name,
            al.amount,
            al.payment_date,
            al.status,
            al.remark,
            al.item_no

        FROM amount_list al

        WHERE al.amount_no = #{amountNo}

        ORDER BY
            al.amount_list_no ASC

    </select>



    <!-- =========================================================
         7. 첨부파일 조회
         
         DAO:
         List<Amount.File> selectAmountFilesByAmountNo(int amountNo);
         ========================================================= -->

    <select id="selectAmountFilesByAmountNo"
            parameterType="int"
            resultMap="fileResultMap">

        SELECT
            af.amountattachment_no,
            af.file_path,
            af.origin_name,
            af.change_name,
            af.updated_at,
            af.status,
            af.amount_no

        FROM amount_file af

        WHERE af.amount_no = #{amountNo}
          AND af.status = 'Y'

        ORDER BY
            af.amountattachment_no ASC

    </select>



    <!-- =========================================================
         8. 워케이션별 비용 신청 개수
         
         DAO:
         int selectAmountCountByWorkcationNo(int workcationNo);
         ========================================================= -->

    <select id="selectAmountCountByWorkcationNo"
            parameterType="int"
            resultType="int">

        SELECT COUNT(*)

        FROM amount

        WHERE workcation_no = #{workcationNo}

    </select>



    <!-- =========================================================
         9. 워케이션별 비용 신청 목록
         
         DAO:
         List<Amount> selectAmountListByWorkcationNo(
             int workcationNo,
             PageInfo pi
         );
         
         RowBounds 사용
         ========================================================= -->

    <select id="selectAmountListByWorkcationNo"
            resultMap="amountResultMap">

        SELECT
            a.amount_no,
            a.requested_amount,
            a.approved_amount,
            a.requested_at,
            a.approved_at,
            a.created_at,
            a.updated_at,
            a.status,
            a.amount_comment,
            a.workcation_no,
            e.emp_name

        FROM amount a

        LEFT JOIN workcation_info w
            ON a.workcation_no = w.workcation_no

        LEFT JOIN employee e
            ON w.emp_no = e.emp_no

        WHERE a.workcation_no = #{workcationNo}

        ORDER BY
            a.created_at DESC,
            a.amount_no DESC

    </select>



    <!-- =========================================================
         10. 비용 신청 등록
         
         DAO:
         int insertAmount(Amount amount);
         
         generated key:
         amount.amountNo
         ========================================================= -->

    <insert id="insertAmount"
            parameterType="com.kh.workflow.amount.vo.Amount"
            useGeneratedKeys="true"
            keyProperty="amountNo"
            keyColumn="amount_no">

        INSERT INTO amount (
            requested_amount,
            approved_amount,
            requested_at,
            created_at,
            status,
            amount_comment,
            workcation_no
        )

        VALUES (
            #{requestedAmount},
            #{approvedAmount},
            #{requestedAt},
            NOW(),
            #{status},
            #{amountComment},
            #{workcationNo}
        )

    </insert>



    <!-- =========================================================
         11. 비용 상세 항목 등록
         
         DAO:
         int insertAmountItem(Amount.Item item);
         
         DB:
         amount_item.amountamountitem_type
         ========================================================= -->

    <insert id="insertAmountItem"
            parameterType="com.kh.workflow.amount.vo.Amount$Item"
            useGeneratedKeys="true"
            keyProperty="itemNo"
            keyColumn="item_no">

        INSERT INTO amount_item (
            amountamountitem_type,
            item_date,
            item_approved,
            item_description,
            amount_no,
            amount
        )

        VALUES (
            #{itemType},
            #{itemDate},
            #{itemApproved},
            #{itemDescription},
            #{amountNo},
            #{amount}
        )

    </insert>



    <!-- =========================================================
         12. 지자체 지원금 등록
         
         DAO:
         int insertAmountSponsor(Amount.Sponsor sponsor);
         
         DB:
         amount_list
         ========================================================= -->

    <insert id="insertAmountSponsor"
            parameterType="com.kh.workflow.amount.vo.Amount$Sponsor"
            useGeneratedKeys="true"
            keyProperty="amountListNo"
            keyColumn="amount_list_no">

        INSERT INTO amount_list (
            amount_no,
            sponsor_name,
            amount,
            payment_date,
            status,
            remark,
            item_no
        )

        VALUES (
            #{amountNo},
            #{sponsorName},
            #{amount},
            #{paymentDate},
            #{status},
            #{remark},
            #{itemNo}
        )

    </insert>



    <!-- =========================================================
         13. 첨부파일 등록
         
         DAO:
         int insertAmountFile(Amount.File file);
         ========================================================= -->

    <insert id="insertAmountFile"
            parameterType="com.kh.workflow.amount.vo.Amount$File"
            useGeneratedKeys="true"
            keyProperty="amountattachmentNo"
            keyColumn="amountattachment_no">

        INSERT INTO amount_file (
            file_path,
            origin_name,
            change_name,
            updated_at,
            status,
            amount_no
        )

        VALUES (
            #{filePath},
            #{originName},
            #{changeName},
            NOW(),
            'Y',
            #{amountNo}
        )

    </insert>



    <!-- =========================================================
         14. 비용 신청 수정
         
         DAO:
         int updateAmount(Amount amount);
         
         수정 가능한 상태:
         R 검토
         H 보류
         ========================================================= -->

    <update id="updateAmount"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET
            requested_amount = #{requestedAmount},
            amount_comment = #{amountComment},
            updated_at = NOW()

        WHERE amount_no = #{amountNo}

          AND status IN ('R', 'H')

    </update>



    <!-- =========================================================
         15. 결재 상태 변경
         
         DAO:
         int updateApprovalStatus(Amount amount);
         
         A = 승인
         H = 보류
         J = 반려
         
         승인(A)일 때:
         approved_amount = 승인금액
         approved_at = 현재시간
         
         H/J일 때:
         기존 approved_amount / approved_at 유지
         ========================================================= -->

    <update id="updateApprovalStatus"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET
            status = #{status},

            approved_amount =
                CASE
                    WHEN #{status} = 'A'
                    THEN #{approvedAmount}
                    ELSE approved_amount
                END,

            amount_comment = #{amountComment},

            approved_at =
                CASE
                    WHEN #{status} = 'A'
                    THEN NOW()
                    ELSE approved_at
                END,

            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         16. 비용 신청 취소
         
         DAO:
         int cancelAmount(int amountNo);
         
         R = 검토
         H = 보류
         → 취소 가능
         ========================================================= -->

    <update id="cancelAmount"
            parameterType="int">

        UPDATE amount

        SET
            status = 'C',
            updated_at = NOW()

        WHERE amount_no = #{amountNo}

          AND status IN ('R', 'H')

    </update>



    <!-- =========================================================
         17. 첨부파일 삭제
         
         DAO:
         int deleteFile(int amountattachmentNo);
         
         실제 파일 삭제가 아닌
         DB status = N 처리
         ========================================================= -->

    <update id="deleteFile"
            parameterType="int">

        UPDATE amount_file

        SET
            status = 'N',
            updated_at = NOW()

        WHERE amountattachment_no = #{amountattachmentNo}

          AND status = 'Y'

    </update>



    <!-- =========================================================
         18. 기존 지원금 전체 삭제
         
         DAO:
         int deleteAmountSponsorsByAmountNo(int amountNo);
         
         중요:
         amount_list.item_no가 amount_item.item_no를
         FK로 참조하므로 item 삭제 전에 반드시 실행
         ========================================================= -->

    <delete id="deleteAmountSponsorsByAmountNo"
            parameterType="int">

        DELETE FROM amount_list

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         19. 기존 비용 상세 항목 전체 삭제
         
         DAO:
         int deleteAmountItemsByAmountNo(int amountNo);
         
         지원금 삭제 이후 실행
         ========================================================= -->

    <delete id="deleteAmountItemsByAmountNo"
            parameterType="int">

        DELETE FROM amount_item

        WHERE amount_no = #{amountNo}

    </delete>




<!-- =========================================================
     20. 전체 통계 - 요약
     
     React Statistics.jsx에서 사용하는 값:
     totalCount
     totalRequestedAmount
     totalApprovedAmount
     reviewCount
     approvedCount
     holdCount
     rejectedCount
     cancelledCount
     ========================================================= -->

<select id="getStatisticsSummary"
        resultType="map">

    SELECT

        -- 전체 비용 신청 건수
        COUNT(*) AS totalCount,

        -- 전체 신청 금액
        COALESCE(
            SUM(requested_amount),
            0
        ) AS totalRequestedAmount,

        -- 승인된 금액 합계
        COALESCE(
            SUM(
                CASE
                    WHEN status = 'A'
                    THEN COALESCE(approved_amount, 0)
                    ELSE 0
                END
            ),
            0
        ) AS totalApprovedAmount,

        -- 검토
        SUM(
            CASE
                WHEN status = 'R' THEN 1
                ELSE 0
            END
        ) AS reviewCount,

        -- 승인
        SUM(
            CASE
                WHEN status = 'A' THEN 1
                ELSE 0
            END
        ) AS approvedCount,

        -- 보류
        SUM(
            CASE
                WHEN status = 'H' THEN 1
                ELSE 0
            END
        ) AS holdCount,

        -- 반려
        SUM(
            CASE
                WHEN status = 'J' THEN 1
                ELSE 0
            END
        ) AS rejectedCount,

        -- 취소
        SUM(
            CASE
                WHEN status = 'C' THEN 1
                ELSE 0
            END
        ) AS cancelledCount

    FROM amount

</select>


<!-- =========================================================
     21. 전체 통계 - 부서별

     승인된 비용 기준

     반환:
     depId
     depTitle
     amountCount
     requestedAmount
     approvedAmount
     ========================================================= -->

<select id="getDeptStatistics"
        resultType="map">

    SELECT

        d.dep_id AS depId,

        d.dep_title AS depTitle,

        -- 승인된 비용 신청 건수
        COUNT(a.amount_no) AS amountCount,

        -- 승인된 신청 금액 합계
        COALESCE(
            SUM(a.requested_amount),
            0
        ) AS requestedAmount,

        -- 실제 승인 금액 합계
        COALESCE(
            SUM(a.approved_amount),
            0
        ) AS approvedAmount

    FROM amount a

    INNER JOIN workcation_info w
        ON a.workcation_no = w.workcation_no

    INNER JOIN employee e
        ON w.emp_no = e.emp_no

    INNER JOIN department d
        ON e.dep_id = d.dep_id

    WHERE a.status = 'A'

    GROUP BY
        d.dep_id,
        d.dep_title

    ORDER BY
        d.dep_id

</select>


<!-- =========================================================
     22. 전체 통계 - 월별

     승인된 비용 기준

     반환:
     month
     amountCount
     requestedAmount
     approvedAmount
     ========================================================= -->

<select id="getMonthlyStatistics"
        resultType="map">

    SELECT

        DATE_FORMAT(
            a.approved_at,
            '%Y-%m'
        ) AS month,

        -- 해당 월 승인 건수
        COUNT(a.amount_no) AS amountCount,

        -- 해당 월 신청 금액
        COALESCE(
            SUM(a.requested_amount),
            0
        ) AS requestedAmount,

        -- 해당 월 승인 금액
        COALESCE(
            SUM(a.approved_amount),
            0
        ) AS approvedAmount

    FROM amount a

    WHERE a.status = 'A'

      AND a.approved_at IS NOT NULL

    GROUP BY
        DATE_FORMAT(
            a.approved_at,
            '%Y-%m'
        )

    ORDER BY
        month ASC

</select>


<!-- =========================================================
     23. 전체 통계 - 비용 항목별

     amount_item.amount 기준

     S = 숙박
     T = 교통
     E = 체험
     F = 식비
     V = 차량
     O = 기타

     반환:
     itemType
     itemCount
     totalAmount
     approvedAmount

     현재 amount_item.amount가 회사 지원금이므로
     승인된 amount에 연결된 항목만 집계
     ========================================================= -->

<select id="getItemStatistics"
        resultType="map">

    SELECT

        ai.amountamountitem_type AS itemType,

        -- 항목 개수
        COUNT(ai.item_no) AS itemCount,

        -- 항목별 회사 지원금 합계
        COALESCE(
            SUM(ai.amount),
            0
        ) AS totalAmount,

        -- 승인된 비용의 항목 금액
        COALESCE(
            SUM(ai.amount),
            0
        ) AS approvedAmount

    FROM amount_item ai

    INNER JOIN amount a
        ON ai.amount_no = a.amount_no

    WHERE a.status = 'A'

      AND ai.item_approved = 'Y'

    GROUP BY
        ai.amountamountitem_type

    ORDER BY
        ai.amountamountitem_type

</select>




</mapper>

