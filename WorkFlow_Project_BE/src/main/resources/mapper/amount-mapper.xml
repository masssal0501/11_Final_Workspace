<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kh.workflow.amount.dao.AmountDao">


    <!-- =========================================================
         1. Amount ResultMap
         ========================================================= -->

    <resultMap id="amountResultMap"
               type="com.kh.workflow.amount.vo.Amount">

        <id property="amountNo"
            column="amount_no"/>

        <result property="requestedAmount"
                column="requested_amount"/>

        <result property="approvedAmount"
                column="approved_amount"/>

        <result property="requestedAt"
                column="requested_at"/>

        <result property="approvedAt"
                column="approved_at"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

        <result property="amountComment"
                column="amount_comment"/>

        <result property="workcationNo"
                column="workcation_no"/>

        <result property="empName"
                column="emp_name"/>


        <!-- 항목 목록 -->
        <collection property="itemList"
                    ofType="com.kh.workflow.amount.vo.Amount$Item"
                    select="selectAmountItemsByAmountNo"
                    column="amount_no"/>


        <!-- 지자체 지원금 목록 -->
        <collection property="sponsorList"
                    ofType="com.kh.workflow.amount.vo.Amount$Sponsor"
                    select="selectSponsorsByAmountNo"
                    column="amount_no"/>


        <!-- 첨부파일 목록 -->
        <collection property="fileList"
                    ofType="com.kh.workflow.amount.vo.Amount$File"
                    select="selectAmountFilesByAmountNo"
                    column="amount_no"/>

    </resultMap>



    <!-- =========================================================
         2. Item ResultMap

         실제 DB amount_item 컬럼
         item_no
         item_type
         item_date
         item_approved
         item_description
         amount_no

         ※ amount_item에는 amount 컬럼 없음
         ========================================================= -->

   <resultMap id="itemResultMap"
           type="com.kh.workflow.amount.vo.Amount$Item">

    <id property="itemNo"
        column="item_no"/>

    <result property="itemType"
            column="amountamountitem_type"/>

    <result property="itemDate"
            column="item_date"/>

    <result property="itemApproved"
            column="item_approved"/>

    <result property="itemDescription"
            column="item_description"/>

    <result property="amountNo"
            column="amount_no"/>

</resultMap>



    <!-- =========================================================
         3. Sponsor ResultMap

         실제 DB amount_list 컬럼
         amount_list_no
         amount_no
         sponsor_name
         amount
         payment_date
         status
         remark

         ※ item_no 없음
         ========================================================= -->

    <resultMap id="sponsorResultMap"
               type="com.kh.workflow.amount.vo.Amount$Sponsor">

        <id property="amountListNo"
            column="amount_list_no"/>

        <result property="amountNo"
                column="amount_no"/>

        <result property="sponsorName"
                column="sponsor_name"/>

        <result property="amount"
                column="amount"/>

        <result property="paymentDate"
                column="payment_date"/>

        <result property="status"
                column="status"/>

        <result property="remark"
                column="remark"/>

    </resultMap>



    <!-- =========================================================
         4. File ResultMap

         실제 DB amount_file 컬럼
         amountattachment_no
         file_path
         origin_name
         change_name
         updated_at
         status
         amount_no
         ========================================================= -->

    <resultMap id="fileResultMap"
               type="com.kh.workflow.amount.vo.Amount$File">

        <id property="amountattachmentNo"
            column="amountattachment_no"/>

        <result property="amountNo"
                column="amount_no"/>

        <result property="originalName"
                column="origin_name"/>

        <result property="storedName"
                column="change_name"/>

        <result property="filePath"
                column="file_path"/>

        <result property="updatedAt"
                column="updated_at"/>

        <result property="status"
                column="status"/>

    </resultMap>



    <!-- =========================================================
         5. 관리자 비용 목록 COUNT
         ========================================================= -->

    <select id="getAmountListCount"
            resultType="int">

        SELECT COUNT(*)

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

    </select>



    <!-- =========================================================
         6. 관리자 비용 목록
         ========================================================= -->

    <select id="selectAmountList"
            resultMap="amountResultMap">

        SELECT

            a.amount_no,

            a.requested_amount,

            a.approved_amount,

            a.requested_at,

            a.approved_at,

            a.created_at,

            a.updated_at,

            a.status,

            a.amount_comment,

            a.workcation_no,

            e.emp_name AS emp_name

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        ORDER BY a.amount_no DESC

    </select>



    <!-- =========================================================
         7. 비용 상세 조회
         ========================================================= -->

    <select id="selectAmountById"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT

            a.amount_no,

            a.requested_amount,

            a.approved_amount,

            a.requested_at,

            a.approved_at,

            a.created_at,

            a.updated_at,

            a.status,

            a.amount_comment,

            a.workcation_no,

            e.emp_name AS emp_name

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        WHERE a.amount_no = #{amountNo}

    </select>



    <!-- =========================================================
         8. 항목 목록 조회
         ========================================================= -->

   <select id="selectAmountItemsByAmountNo"
        parameterType="int"
        resultMap="itemResultMap">

    SELECT
        item_no,
        amountamountitem_type,
        item_date,
        item_approved,
        item_description,
        amount_no
    FROM amount_item
    WHERE amount_no = #{amountNo}
    ORDER BY item_no ASC

</select>



    <!-- =========================================================
         9. 지자체 지원금 목록 조회
         ========================================================= -->

    <select id="selectSponsorsByAmountNo"
            parameterType="int"
            resultMap="sponsorResultMap">

        SELECT

            amount_list_no,

            amount_no,

            sponsor_name,

            amount,

            payment_date,

            status,

            remark

        FROM amount_list

        WHERE amount_no = #{amountNo}

        ORDER BY amount_list_no ASC

    </select>



    <!-- =========================================================
         10. 첨부파일 목록 조회
         ========================================================= -->

    <select id="selectAmountFilesByAmountNo"
            parameterType="int"
            resultMap="fileResultMap">

        SELECT

            amountattachment_no,

            amount_no,

            origin_name,

            change_name,

            file_path,

            updated_at,

            status

        FROM amount_file

        WHERE amount_no = #{amountNo}

        ORDER BY amountattachment_no ASC

    </select>



    <!-- =========================================================
         11. 워케이션별 비용 COUNT
         ========================================================= -->

    <select id="selectAmountCountByWorkcationNo"
            parameterType="int"
            resultType="int">

        SELECT COUNT(*)

        FROM amount

        WHERE workcation_no = #{workcationNo}

    </select>



    <!-- =========================================================
         12. 워케이션별 비용 목록
         ========================================================= -->

    <select id="selectAmountListByWorkcationNo"
            parameterType="int"
            resultMap="amountResultMap">

        SELECT

            a.amount_no,

            a.requested_amount,

            a.approved_amount,

            a.requested_at,

            a.approved_at,

            a.created_at,

            a.updated_at,

            a.status,

            a.amount_comment,

            a.workcation_no,

            e.emp_name AS emp_name

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        WHERE a.workcation_no = #{workcationNo}

        ORDER BY a.amount_no DESC

    </select>



    <!-- =========================================================
         13. 비용 등록
         ========================================================= -->

    <insert id="insertAmount"
            parameterType="com.kh.workflow.amount.vo.Amount"
            useGeneratedKeys="true"
            keyProperty="amountNo">

        INSERT INTO amount (

            requested_amount,

            approved_amount,

            requested_at,

            approved_at,

            status,

            amount_comment,

            workcation_no

        )

        VALUES (

            #{requestedAmount},

            #{approvedAmount},

            #{requestedAt},

            #{approvedAt},

            #{status},

            #{amountComment},

            #{workcationNo}

        )

    </insert>



    <!-- =========================================================
         14. 항목 등록

         실제 DB amount_item에는 amount 컬럼 없음
         ========================================================= -->

    <insert id="insertAmountItem"
            parameterType="com.kh.workflow.amount.vo.Amount$Item"
            useGeneratedKeys="true"
            keyProperty="itemNo">

        INSERT INTO amount_item (

            item_type,

            item_date,

            item_approved,

            item_description,

            amount_no

        )

        VALUES (

            #{itemType},

            #{itemDate},

            #{itemApproved},

            #{itemDescription},

            #{amountNo}

        )

    </insert>



    <!-- =========================================================
         15. 지자체 지원금 등록

         실제 DB amount_list 기준
         ========================================================= -->

    <insert id="insertAmountSponsor"
            parameterType="com.kh.workflow.amount.vo.Amount$Sponsor"
            useGeneratedKeys="true"
            keyProperty="amountListNo">

        INSERT INTO amount_list (

            amount_no,

            sponsor_name,

            amount,

            payment_date,

            status,

            remark

        )

        VALUES (

            #{amountNo},

            #{sponsorName},

            #{amount},

            #{paymentDate},

            #{status},

            #{remark}

        )

    </insert>



    <!-- =========================================================
         16. 첨부파일 등록

         실제 DB amount_file 기준

         amountattachment_no
         file_path
         origin_name
         change_name
         updated_at
         status
         amount_no
         ========================================================= -->

    <insert id="insertAmountFile"
            parameterType="com.kh.workflow.amount.vo.Amount$File"
            useGeneratedKeys="true"
            keyProperty="amountattachmentNo">

        INSERT INTO amount_file (

            file_path,

            origin_name,

            change_name,

            updated_at,

            status,

            amount_no

        )

        VALUES (

            #{filePath},

            #{originalName},

            #{storedName},

            NOW(),

            'Y',

            #{amountNo}

        )

    </insert>



    <!-- =========================================================
         17. 비용 기본정보 수정

         amount_list는 수정하지 않음
         amount_item도 여기서는 수정하지 않음
         ========================================================= -->

    <update id="updateAmount"
            parameterType="com.kh.workflow.amount.vo.Amount">

        UPDATE amount

        SET

            requested_amount = #{requestedAmount},

            amount_comment = #{amountComment},

            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         18. 승인 상태 변경
         ========================================================= -->

    <update id="updateApprovalStatus"
            parameterType="map">

        UPDATE amount

        SET

            status = #{status},

            approved_amount = #{approvedAmount},

            amount_comment = #{amountComment},

            approved_at =

                CASE

                    WHEN #{status} = 'A'

                    THEN NOW()

                    ELSE approved_at

                END,

            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         19. 비용 취소
         ========================================================= -->

    <update id="cancelAmount"
            parameterType="int">

        UPDATE amount

        SET

            status = 'C',

            updated_at = NOW()

        WHERE amount_no = #{amountNo}

    </update>



    <!-- =========================================================
         20. 첨부파일 삭제
         ========================================================= -->

    <delete id="deleteFile"
            parameterType="int">

        DELETE FROM amount_file

        WHERE amountattachment_no = #{amountattachmentNo}

    </delete>



    <!-- =========================================================
         21. 지자체 지원금 전체 삭제

         주의:
         외부 지원금 데이터이므로 일반 비용 수정에서는
         호출하지 않는 것을 전제로 유지.

         현재 DAO에 메서드가 있으므로 mapper만 유지.
         ========================================================= -->

    <delete id="deleteAmountSponsorsByAmountNo"
            parameterType="int">

        DELETE FROM amount_list

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         22. 항목 전체 삭제

         주의:
         amount_item을 삭제하면 기존 item_no를 참조하는
         외부 데이터가 있을 경우 문제가 발생할 수 있으므로
         일반 수정에서는 사용하지 않는 것을 권장.
         ========================================================= -->

    <delete id="deleteAmountItemsByAmountNo"
            parameterType="int">

        DELETE FROM amount_item

        WHERE amount_no = #{amountNo}

    </delete>



    <!-- =========================================================
         23. 통계 - 전체 요약
         ========================================================= -->

    <select id="getStatisticsSummary"
            resultType="map">

        SELECT

            COUNT(*) AS totalCount,

            COALESCE(
                SUM(requested_amount),
                0
            ) AS totalRequested,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'A'
                        THEN approved_amount
                        ELSE 0
                    END
                ),
                0
            ) AS totalApproved,

            SUM(
                CASE
                    WHEN status = 'A'
                    THEN 1
                    ELSE 0
                END
            ) AS approvedCount,

            SUM(
                CASE
                    WHEN status = 'R'
                    THEN 1
                    ELSE 0
                END
            ) AS reviewCount,

            SUM(
                CASE
                    WHEN status = 'H'
                    THEN 1
                    ELSE 0
                END
            ) AS holdCount,

            SUM(
                CASE
                    WHEN status = 'J'
                    THEN 1
                    ELSE 0
                END
            ) AS rejectedCount,

            SUM(
                CASE
                    WHEN status = 'C'
                    THEN 1
                    ELSE 0
                END
            ) AS cancelledCount

        FROM amount

    </select>



    <!-- =========================================================
         24. 통계 - 부서별
         승인된 비용 기준

         employee.dep_id
         department.dep_id
         department.dep_title
         ========================================================= -->

    <select id="getDeptStatistics"
            resultType="map">

        SELECT

            d.dep_title AS departmentName,

            COALESCE(
                SUM(a.approved_amount),
                0
            ) AS approvedAmount

        FROM amount a

        JOIN workcation_info w
          ON a.workcation_no = w.workcation_no

        JOIN employee e
          ON w.emp_no = e.emp_no

        JOIN department d
          ON e.dep_id = d.dep_id

        WHERE a.status = 'A'

        GROUP BY

            d.dep_id,

            d.dep_title

        ORDER BY approvedAmount DESC

    </select>



    <!-- =========================================================
         25. 통계 - 월별
         승인된 비용 기준
         ========================================================= -->

    <select id="getMonthlyStatistics"
            resultType="map">

        SELECT

            DATE_FORMAT(
                approved_at,
                '%Y-%m'
            ) AS month,

            COALESCE(
                SUM(approved_amount),
                0
            ) AS approvedAmount

        FROM amount

        WHERE status = 'A'

          AND approved_at IS NOT NULL

        GROUP BY

            DATE_FORMAT(
                approved_at,
                '%Y-%m'
            )

        ORDER BY month ASC

    </select>



    <!-- =========================================================
         26. 통계 - 항목별

         실제 DB:
         amount_item.item_type
         ========================================================= -->

    <select id="getItemStatistics"
            resultType="map">

        SELECT

            ai.item_type AS itemType,

            COUNT(*) AS itemCount

        FROM amount_item ai

        JOIN amount a
          ON ai.amount_no = a.amount_no

        WHERE a.status = 'A'

        GROUP BY

            ai.item_type

        ORDER BY

            ai.item_type

    </select>


</mapper>